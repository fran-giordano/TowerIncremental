# Fin de línea consistente entre Windows/Mac/Linux
* text=auto

# Archivos de Unity en YAML: merge con UnityYAMLMerge (ver CONTRIBUTING.md)
*.unity    text merge=unityyamlmerge eol=lf
*.prefab   text merge=unityyamlmerge eol=lf
*.asset    text merge=unityyamlmerge eol=lf
*.mat      text merge=unityyamlmerge eol=lf
*.anim     text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta     text eol=lf
*.cs       text diff=csharp

# Binarios
*.png binary
*.jpg binary
*.tga binary
*.psd binary
*.gif binary
*.fbx binary
*.blend binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
